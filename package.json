{
  "name": "web-api-client",
  "version": "0.1.0",
  "description": "Compose and send HTTP requests from the browser through a proxy that refuses private network addresses.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:cli": "tsc -p tsconfig.cli.json",
    "collection": "npm run build:cli --silent && node scripts/run-collection.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "quickjs-emscripten": "0.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.1",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
