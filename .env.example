# Local development needs nothing: with no MONGODB_URI the workspace lives in
# memory, seeded with example requests.

# MongoDB Atlas Free (512 MB) -- cloud.mongodb.com
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=web_api_client

# Separate database for the live store test suite, so running tests never
# touches the collections the app is using.
# MONGODB_TEST_DB=web_api_client_test

# Lets the relay reach 127.0.0.1 and private ranges. Off by default.
# On a public deployment this turns the proxy into a window onto the host's
# private network, so set it only for local use against your own services.
# PROXY_ALLOW_PRIVATE=true

# Optional OAuth login. Create an app in each provider console and register:
#   http://localhost:3000/api/auth/oauth/google/callback
#   http://localhost:3000/api/auth/oauth/github/callback
# Replace the origin with the deployed origin in production.
# Shared rate-limit store. Without it the quota is per-instance and in memory,
# so a cold start hands out a fresh allowance -- do not deploy publicly that way.
# Upstash Redis has a free tier and speaks HTTP, so it works from serverless.
# The REST URL from the dashboard's REST API tab -- not the redis-cli
# command line, which is not a URL and is ignored with a warning.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# How many proxies sit in front of the app, for reading X-Forwarded-For.
# 0 (the default) means the header is NOT trusted at all and every
# unidentified caller shares one quota bucket. Set it to the real number of
# trusted hops only; too high lets a client forge entries and claim its own
# bucket. On Vercel the platform header is used automatically and this can
# stay 0.
# TRUSTED_PROXY_HOPS=1

# Public application origin, used to build OAuth callback URLs in production.
# APP_URL=https://relay.example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Outgoing email, used only for the password-reset link. Without a provider
# key and MAIL_FROM the reset endpoint still answers, and says plainly that
# this deployment cannot send mail -- it never pretends a link is on its way.
#
# Either provider works; both have a free tier and both are HTTP, so neither
# needs an SMTP connection. Set one key, or set both and name the one to use.
#   Resend  free: 3,000 emails/month, 100/day
#   Brevo   free: 300 emails/day
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAIL_PROVIDER=resend
#
# MAIL_FROM is an address, optionally with a display name. The address has to
# be at a domain you have verified with the provider -- that is the part no
# free tier waives. Without a verified domain:
#   Resend accepts onboarding@resend.dev but delivers only to the address on
#   your own Resend account, which is enough to demonstrate the flow.
#   Brevo will not activate transactional sending at all, and a @gmail.com
#   sender cannot be authenticated.
# MAIL_FROM=Relay <relay@example.com>
